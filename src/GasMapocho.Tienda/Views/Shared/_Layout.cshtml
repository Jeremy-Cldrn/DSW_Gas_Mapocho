@{
    var carrito = Context.Session.GetInt32("CarritoItems") ?? 0;
    var activo = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var autenticado = Context.Session.Autenticado();
    var nombreCliente = Context.Session.NombreUsuario();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Gas Mapocho</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mulish:wght@300;400;600;700&family=Montserrat:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    @* Orden importante: tokens y componentes DESPUÉS de Bootstrap *@
    <link rel="stylesheet" href="~/_content/GasMapocho.Ui/css/tokens.css" />
    <link rel="stylesheet" href="~/_content/GasMapocho.Ui/css/componentes.css" />
    <link rel="stylesheet" href="~/css/tienda.css" asp-append-version="true" />
</head>
<body>
    <a href="#contenido" class="visually-hidden-focusable skip-link">Saltar al contenido</a>

    <header class="cabecera">
        <div class="container cabecera-inner">
            <a href="/Catalogo" class="d-flex align-items-center" aria-label="Gas Mapocho — ir al catálogo">
                <img src="~/_content/GasMapocho.Ui/img/logoGasco2024.png" alt="Gas Mapocho" class="brand-logo" />
            </a>

            <nav class="nav-principal" aria-label="Principal">
                <a href="/Catalogo" class="@(activo == "Catalogo" ? "activo" : "")">Catálogo</a>
                <a href="/MisCompras" class="@(activo == "MisCompras" ? "activo" : "")">Mis compras</a>
            </nav>

            <div class="cabecera-acciones">
                <a href="/Carrito" class="btn btn-ghost carrito-btn" aria-label="Ver carrito (@carrito productos)">
                    <span class="material-symbols-outlined icon-24" aria-hidden="true">shopping_cart</span>
                    <span class="d-none d-sm-inline">Carrito</span>
                    <span class="carrito-contador js-carrito-contador @(carrito == 0 ? "vacio" : "")">@carrito</span>
                </a>
                @if (autenticado)
                {
                    <div class="dropdown">
                        <button class="btn btn-ghost dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="material-symbols-outlined icon-24" aria-hidden="true">account_circle</span>
                            <span class="d-none d-md-inline">@nombreCliente</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/Perfil">Mi perfil</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                @* El cierre de sesión va por POST: un enlace GET lo dispararía
                                   cualquier imagen remota apuntando a esa URL. *@
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/Account/Login" class="btn btn-ghost">
                        <span class="material-symbols-outlined icon-24" aria-hidden="true">account_circle</span>
                        <span class="d-none d-md-inline">Ingresar</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <main id="contenido" class="py-4 py-md-5">
        <div class="container">
            <partial name="_MensajesAlerta" />
            @RenderBody()
        </div>
    </main>

    <footer class="pie">
        <div class="container">
            <div class="row g-4">
                <div class="col-12">
                    <h2 style="font-size:var(--fs-h3)" class="mb-3">Atención al cliente</h2>
                </div>
                <div class="col-6 col-md-3">
                    <div class="pie-etiqueta mb-1">Emergencias</div>
                    <div>600 600 77 99</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="pie-etiqueta mb-1">Dirección</div>
                    <div>GAS MAPOCHO</div>
                    <div>MAPOCHO 2933</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="pie-etiqueta mb-1">Horario</div>
                    <div>Lun-Sab 10:00 a 19:00</div>
                    <div>Dom 10:00 a 14:00</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="pie-etiqueta mb-1">Teléfonos</div>
                    <div>226818184 - 226824492</div>
                </div>
            </div>
            <hr class="mt-4 mb-3" style="border-color:rgba(255,255,255,.25)" />
            <small>&copy; @DateTime.Now.Year Gas Mapocho. Todos los derechos reservados.</small>
        </div>
    </footer>

    @* Botón flotante de WhatsApp: color de marca (celeste), no el verde de
       WhatsApp, para que no desentone con la identidad de Gas Mapocho. *@
    <a class="whatsapp-flotante" href="https://wa.me/56975035774" target="_blank" rel="noopener"
       aria-label="Chatear por WhatsApp con Gas Mapocho">
        <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="currentColor">
            <path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.5 1.34 5.02L2 22l5.13-1.35a9.96 9.96 0 0 0 4.91 1.29h.01c5.52 0 10-4.48 10-10s-4.48-9.94-10.01-9.94Zm0 18.24h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.84-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.38c0-4.55 3.71-8.26 8.27-8.26 2.21 0 4.28.86 5.85 2.42a8.19 8.19 0 0 1 2.42 5.85c0 4.56-3.71 8.23-8.3 8.23Zm4.53-6.17c-.25-.12-1.47-.72-1.7-.81-.23-.08-.4-.12-.56.13-.17.25-.65.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.71-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.36-.77-1.86-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.86-.87 2.09 0 1.23.89 2.42 1.02 2.59.12.17 1.75 2.7 4.26 3.78.59.26 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.11-.23-.17-.48-.29Z"/>
        </svg>
    </a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/GasMapocho.Ui/js/formato.js"></script>
    <script src="~/_content/GasMapocho.Ui/js/tabla.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
