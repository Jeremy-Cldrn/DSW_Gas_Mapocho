@model GasMapocho.Tienda.Controllers.LoginVm
@{
    Layout = "_LayoutAuth";
}

<div class="login-marca">
    <img src="~/_content/GasMapocho.Ui/img/logoGasco2024.png" alt="Gas Mapocho" style="height:48px" />
</div>

<div class="login-card">
    <p class="text-uppercase fw-bold mb-1"
       style="letter-spacing:.06em; font-size:var(--fs-xs); color:var(--gs-primary-700)">
        Tienda en línea
    </p>
    <h1 class="mb-1">Iniciar sesión</h1>
    <p class="text-muted-gs mb-4" style="font-size:var(--fs-sm)">
        Ingresa para pedir tu balón de gas.
    </p>

    @*
        Mensaje genérico de credenciales inválidas. Nunca revela si falló el
        correo o la contraseña: eso permitiría averiguar qué correos existen.
    *@
    <div asp-validation-summary="ModelOnly" class="alerta-gs alerta-error mb-4"></div>

    <form asp-action="Login" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Email" class="form-label">
                Correo <span class="req" aria-hidden="true">*</span>
            </label>
            <input asp-for="Email" class="form-control" type="email"
                   autocomplete="email" placeholder="tu@correo.cl" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label">
                Contraseña <span class="req" aria-hidden="true">*</span>
            </label>
            <input asp-for="Password" class="form-control" type="password"
                   autocomplete="current-password" placeholder="••••••••" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn btn-conversion w-100">Ingresar</button>

        <div class="text-center mt-3">
            <a href="#" style="font-size:var(--fs-sm)">¿Olvidaste tu contraseña?</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
