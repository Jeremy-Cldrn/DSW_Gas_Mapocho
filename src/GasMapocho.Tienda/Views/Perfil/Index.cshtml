@model ClienteVm
@*
    Solo informativa: el encargo pide expresamente que no se pueda editar
    nada desde acá (§15.1).
*@

<div class="mb-4">
    <h1 class="mb-1">Mi perfil</h1>
    <p class="text-muted-gs mb-0">Estos son los datos que tenemos registrados.</p>
</div>

<div class="card-gs mx-auto" style="max-width:560px">
    <div class="card-gs-body">
        <dl class="row mb-0">
            <dt class="col-5 col-sm-4 text-muted-gs fw-normal">Nombre</dt>
            <dd class="col-7 col-sm-8 fw-bold text-navy">@Model.Nombre</dd>

            <dt class="col-5 col-sm-4 text-muted-gs fw-normal">RUT</dt>
            <dd class="col-7 col-sm-8">@Model.Documento</dd>

            <dt class="col-5 col-sm-4 text-muted-gs fw-normal">Correo</dt>
            <dd class="col-7 col-sm-8">@Model.Email</dd>

            <dt class="col-5 col-sm-4 text-muted-gs fw-normal">Teléfono</dt>
            <dd class="col-7 col-sm-8">@Model.Telefono</dd>

            <dt class="col-5 col-sm-4 text-muted-gs fw-normal">Comuna</dt>
            <dd class="col-7 col-sm-8">@Model.Comuna</dd>

            <dt class="col-5 col-sm-4 text-muted-gs fw-normal mb-0">Dirección</dt>
            <dd class="col-7 col-sm-8 mb-0">@Model.Direccion</dd>
        </dl>
    </div>
</div>
