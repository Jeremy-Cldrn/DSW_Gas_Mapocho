@model GasMapocho.Admin.Controllers.RecuperarPasswordVm
@{
    Layout = "_LayoutAuth";
}

<div class="login-marca">
    <img src="~/_content/GasMapocho.Ui/img/logoGasco2024.png" alt="Gas Mapocho" style="height:48px" />
</div>

<div class="login-card">
    <p class="text-uppercase fw-bold mb-1"
       style="letter-spacing:.06em; font-size:var(--fs-xs); color:var(--gs-primary-700)">
        Portal administrativo
    </p>
    <h1 class="mb-1">Recuperar contraseña</h1>
    <p class="text-muted-gs mb-4" style="font-size:var(--fs-sm)">
        Ingresa tu correo de administrador y la nueva contraseña que quieras usar.
    </p>

    <div asp-validation-summary="ModelOnly" class="alerta-gs alerta-error mb-4"></div>

    <form asp-action="RecuperarPassword" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Email" class="form-label">
                Correo <span class="req" aria-hidden="true">*</span>
            </label>
            <input asp-for="Email" class="form-control" type="email"
                   autocomplete="email" placeholder="admin@gasmapocho.cl" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NuevaPassword" class="form-label">
                Nueva contraseña <span class="req" aria-hidden="true">*</span>
            </label>
            <input asp-for="NuevaPassword" class="form-control" type="password"
                   autocomplete="new-password" placeholder="••••••••" />
            <span asp-validation-for="NuevaPassword" class="field-validation-error"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmarPassword" class="form-label">
                Confirmar contraseña <span class="req" aria-hidden="true">*</span>
            </label>
            <input asp-for="ConfirmarPassword" class="form-control" type="password"
                   autocomplete="new-password" placeholder="••••••••" />
            <span asp-validation-for="ConfirmarPassword" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn btn-conversion w-100">Actualizar contraseña</button>

        <div class="text-center mt-3">
            <a asp-action="Login" style="font-size:var(--fs-sm)">Volver a iniciar sesión</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
