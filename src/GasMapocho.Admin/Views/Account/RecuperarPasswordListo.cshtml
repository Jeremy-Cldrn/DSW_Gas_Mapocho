@{
    Layout = "_LayoutAuth";
}

<div class="login-marca">
    <img src="~/_content/GasMapocho.Ui/img/logoGasco2024.png" alt="Gas Mapocho" style="height:48px" />
</div>

<div class="login-card text-center">
    <span class="material-symbols-outlined icon-24" aria-hidden="true"
          style="font-size:48px; color:var(--gs-primary-700)">check_circle</span>

    <h1 class="mb-1 mt-2">Contraseña actualizada</h1>
    <p class="text-muted-gs mb-4" style="font-size:var(--fs-sm)">
        La contraseña de <strong>@ViewBag.Correo</strong> se actualizó correctamente.
        Ya puedes iniciar sesión con ella.
    </p>

    <a asp-action="Login" class="btn btn-conversion w-100">Ir a iniciar sesión</a>
</div>
