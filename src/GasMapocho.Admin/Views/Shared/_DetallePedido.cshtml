@model PedidoVm

<div class="d-flex align-items-center justify-content-between mb-3 pb-3"
     style="border-bottom:1px solid var(--gs-gray-200)">
    <partial name="_BadgeEstado" model="@Model.Estado" />

    <form method="post" action="/Ventas/CambiarEstado" class="d-flex align-items-center gap-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <label for="estado-@Model.Id" class="visually-hidden">Nuevo estado</label>
        <select id="estado-@Model.Id" name="estado" class="form-select form-select-sm" style="width:auto">
            @foreach (var e in new[] { "Pendiente", "Aprobado", "Rechazado", "En Proceso", "Entregado", "Finalizado", "Cancelado" })
            {
                <option value="@e" selected="@(e == Model.Estado)">@e</option>
            }
        </select>
        <button type="submit" class="btn btn-primary btn-sm">Actualizar estado</button>
    </form>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <h3 style="font-size:var(--fs-sm)" class="mb-2">Productos</h3>
        @foreach (var l in Model.Lineas)
        {
            <div class="d-flex justify-content-between align-items-baseline py-1" style="font-size:var(--fs-sm)">
                <span>
                    @l.Nombre
                    <span class="text-muted-gs">— @l.Cantidad × @l.PrecioUnitario.ToString("C0") c/u</span>
                </span>
                <span class="num">@l.Subtotal.ToString("C0")</span>
            </div>
        }
        <div class="d-flex justify-content-between align-items-baseline py-1" style="font-size:var(--fs-sm)">
            <span>Despacho</span>
            <span class="num">@Model.Despacho.ToString("C0")</span>
        </div>
        <div class="d-flex justify-content-between align-items-baseline pt-2 mt-2"
             style="border-top:1px solid var(--gs-gray-200)">
            <span class="fw-bold text-navy">Total</span>
            <span class="num fw-bold text-navy" style="font-size:var(--fs-h3)">@Model.Total.ToString("C0")</span>
        </div>
    </div>

    <div class="col-md-5">
        <h3 style="font-size:var(--fs-sm)" class="mb-2">Entrega</h3>
        <div style="font-size:var(--fs-sm)">
            <div class="fw-bold text-navy mb-1">@Model.Cliente</div>
            <div class="mb-1">@Model.Direccion</div>
            <div class="mb-1 text-muted-gs">@Model.Comuna</div>
            <div class="mb-1 text-muted-gs">@Model.Telefono</div>
            <div class="mt-3">
                <span class="text-muted-gs">Método de pago:</span>
                <strong class="text-navy">@Model.MetodoPago</strong>
            </div>
        </div>
    </div>
</div>
